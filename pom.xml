<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.ovelin</groupId>
    <artifactId>ovelin-mall</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ovelin-mall</name>
    <description>ovelin-mall</description>
    <packaging>pom</packaging>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ovelin</groupId>
                <artifactId>mall-ddd-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ovelin</groupId>
                <artifactId>mall-common-sharding-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ovelin</groupId>
                <artifactId>mall-common-sharding-starter</artifactId>
                <version>${project.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>com.ovelin</groupId>
                <artifactId>mall-id-generator-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ovelin</groupId>
                <artifactId>mall-id-generator-starter</artifactId>
                <version>${project.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>com.ovelin</groupId>
                <artifactId>mall-user-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>3.5.17</version>
            </dependency>
            <dependency>
                <groupId>com.ovelin</groupId>
                <artifactId>mall-common-test</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>mall-common-test</module>
        <module>mall-common-sharding-core</module>
        <module>mall-common-sharding-starter</module>
        <module>mall-id-generator-api</module>
        <module>mall-id-generator-starter</module>
        <module>mall-auth</module>
        <module>mall-session</module>
        <module>mall-bom</module>
        <module>mall-cart</module>
        <module>mall-cart-api</module>
        <module>mall-common</module>
        <module>mall-ddd-kernel</module>
        <module>mall-fulfillment</module>
        <module>mall-fulfillment-api</module>
        <module>mall-inventory</module>
        <module>mall-order</module>
        <module>mall-order-api</module>
        <module>mall-payment</module>
        <module>mall-payment-api</module>
        <module>mall-product</module>
        <module>mall-product-api</module>
        <module>mall-promotion</module>
        <module>mall-promotion-api</module>
        <module>mall-user</module>
        <module>mall-user-api</module>
        <module>mall-inventory-api</module>

    </modules>

</project>
