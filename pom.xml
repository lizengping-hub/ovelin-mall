<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.ovelin</groupId>
    <artifactId>ovelin-mall</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ovelin-mall</name>
    <description>ovelin-mall</description>
    <packaging>pom</packaging>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <modelVersion>4.0.0</modelVersion>
    <modules>
        <module>mall-common-sharding-core</module>
        <module>mall-common-sharding-starter</module>
        <module>mall-id-generator-api</module>
        <module>mall-id-generator-starter</module>
        <module>mall-sharding-starter</module>
        <module>mall-bom</module>
        <module>mall-cart</module>
        <module>mall-cart-api</module>
        <module>mall-common</module>
        <module>mall-ddd-kernel</module>
        <module>mall-fulfillment</module>
        <module>mall-fulfillment-api</module>
        <module>mall-inventory</module>
        <module>mall-order</module>
        <module>mall-order-api</module>
        <module>mall-payment</module>
        <module>mall-payment-api</module>
        <module>mall-product</module>
        <module>mall-product-api</module>
        <module>mall-promotion</module>
        <module>mall-promotion-api</module>
        <module>mall-user</module>
        <module>mall-user-api</module>
        <module>mall-inventory-api</module>

    </modules>
</project>
